meta {
  name: Usuário autenticado sem token (401)
  type: http
  seq: 9
}

get {
  url: {{base_url}}/auth/me
  body: none
  auth: none
}

tests {
  test("retorna HTTP 401 com WWW-Authenticate", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("www-authenticate")).to.equal("Bearer");
  });
}
